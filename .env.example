# ============================================================================
# Wok Control — variables de entorno de ejemplo
# Copie este archivo como ".env" en la raíz del proyecto y complete los valores.
# El archivo .env está en .gitignore: NUNCA lo suba al repositorio.
# Cada microservicio lo importa automáticamente al arrancar (spring.config.import).
# Formato: CLAVE=valor (sin comillas y sin espacios alrededor del "=").
# ============================================================================

# --- MongoDB Atlas (obligatorio) ---
# Reemplace <db_password> por la contraseña real. Si contiene caracteres especiales
# (@ : / ? # [ ] %) codifíquelos en URL, por ejemplo @ -> %40.
# No incluya el nombre de la base de datos: cada servicio usa la suya (wok_menu, wok_pedidos, ...).
MONGODB_URI=mongodb+srv://jstevenbecerra_db_user:<db_password>@pcproject.ijrpy8p.mongodb.net/?retryWrites=true&w=majority&appName=pcproject

# --- JWT (obligatorio) ---
# Secreto HMAC de al menos 32 bytes, compartido por todos los servicios.
# Genérelo con:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=<genere_un_secreto_aleatorio_de_al_menos_32_caracteres>
# Duración de la sesión en minutos (por defecto 480 = un turno de 8 horas)
JWT_EXPIRATION_MINUTES=480
# true en producción con HTTPS
WOK_COOKIE_SECURE=false

# --- Primer administrador de plataforma ---
# Se crea una sola vez, solo si no existe ningún usuario. Después de crearlo, borre la
# contraseña de este archivo. El sistema obliga a cambiarla en el primer ingreso.
WOK_BOOTSTRAP_ADMIN_USERNAME=plataforma
WOK_BOOTSTRAP_ADMIN_PASSWORD=

# --- Infraestructura (opcionales, valores por defecto para ejecución local) ---
CONFIG_SERVER_URL=http://localhost:8888
EUREKA_URL=http://localhost:8761/eureka/
WOK_CORS_ORIGINS=http://localhost:8080
WOK_SWAGGER_ENABLED=true

# Clave de los usuarios de demostración que crea scripts/cargar-datos-demo.py (solo entornos de prueba)
WOK_DEMO_PASSWORD=

# --- Render (perfil render): protege Eureka y config-server, que allí tienen URL pública ---
# Solo letras y números (va dentro de la URL de Eureka). En local no se usa.
WOK_INFRA_USER=wok
WOK_INFRA_PASSWORD=
