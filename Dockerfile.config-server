
FROM eclipse-temurin:21-jdk-alpine AS build
WORKDIR /workspace

COPY . .

RUN chmod +x mvnw \
    && ./mvnw -B -pl config-server -am -DskipTests package

FROM eclipse-temurin:21-jre-alpine

RUN addgroup -S wok && adduser -S wok -G wok
WORKDIR /app

COPY --from=build /workspace/config-server/target/config-server-1.0.0-SNAPSHOT.jar /app/app.jar

USER wok
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75"

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
